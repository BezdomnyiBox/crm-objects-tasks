# Публичные значения проекта Supabase (Project Settings → API Keys).
# Скопируйте этот файл в .env.local и подставьте свои значения.
#
# Ключ ниже — «публичный» (publishable / anon): он по замыслу попадает в браузер,
# а доступ к данным ограничивают правила в самой базе (RLS).
#
# НИКОГДА не кладите сюда service_role / secret-ключ: приложение откажется запускаться,
# если увидит такой ключ.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
